# 复制为 scripts/deploy.env 并填写(该文件已在 .gitignore,不要提交)。
#   cp scripts/deploy.env.example scripts/deploy.env
DEPLOY_HOST=user@your.server.ip      # SSH 目标,需已配置密钥登录
DEPLOY_DIR=/opt/enjoy                # 服务器上的仓库目录(含 docker-compose.yml、server/.env)
DEPLOY_BRANCH=main                   # 服务器跑的分支;本地必须在此分支上才允许部署
DEPLOY_REMOTE=origin                 # 推送用的 git remote
# 可选:服务器上的健康检查地址(默认 http://127.0.0.1:8000/up)
# DEPLOY_HEALTH_URL=http://127.0.0.1:8000/up
