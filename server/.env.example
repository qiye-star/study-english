# ---- 数据库(二选一,改这一行即可切换)----
# SQLite(默认,数据在 compose 卷 /data 中)
DATABASE_URL=sqlite+aiosqlite:////data/app.db
# Postgres(同时用 `docker compose --profile postgres up -d`)
# DATABASE_URL=postgresql+asyncpg://enjoy:change-me@postgres:5432/enjoy
# 注意:postgres 容器不会读取本文件。POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# 需在仓库根目录的 .env(见 .env.example)或 shell 环境变量中设置,
# 且密码必须与上面 DATABASE_URL 中的一致(默认值 enjoy / change-me / enjoy)。

# ---- 注册 ----
# open: 任何人可注册 | invite: 需要 INVITE_CODE | closed: 关闭注册
# 默认 closed 以免公网部署时被陌生人消耗你的上游额度。创建第一批账号时,
# 临时改为 open(或 invite 并设置 INVITE_CODE),注册完再改回 closed 并重启。
REGISTRATION_MODE=closed
INVITE_CODE=
# 部署在反向代理之后时设为 true,使用 X-Forwarded-For 做限流
TRUST_PROXY_HEADERS=false
RATE_LIMIT_PER_MINUTE=10
# 每个用户每分钟可调用 AI 接口(/api/ai/*、/api/speech/tokens)的次数
AI_RATE_LIMIT_PER_MINUTE=60

# ---- LLM(OpenAI 兼容)----
# 只需支持 chat completions(含流式)与 JSON 模式;客户端不使用 tool calling。
# DeepSeek 示例:UPSTREAM_LLM_BASE_URL=https://api.deepseek.com,LLM_MODELS=deepseek-v4-pro,deepseek-v4-flash
# (V4 默认 thinking 模式,不支持强制 tool_choice,本客户端不用)。api.openai.com 只是模板默认值。
UPSTREAM_LLM_BASE_URL=https://api.openai.com/v1
UPSTREAM_LLM_KEY=
LLM_MODELS=gpt-4o-mini,gpt-4o
DEFAULT_LLM_MODEL=gpt-4o
# 聊天请求的 max_tokens / max_completion_tokens 上限(n 固定最多 4);请求未带时不添加
LLM_MAX_TOKENS=4096

# ---- 语法检查模型(对话里自动指出语法错误)----
# 留空则使用 DEFAULT_LLM_MODEL;不必出现在 LLM_MODELS 中(客户端看不到、也不能指定)
GRAMMAR_MODEL=
# 留空则复用上面的 LLM 上游;设置了 BASE_URL 时使用下面这个 KEY(不会借用 LLM 的 KEY)
UPSTREAM_GRAMMAR_BASE_URL=
UPSTREAM_GRAMMAR_KEY=
# 替换内置的"检查规则"(输出格式要求由服务端固定追加,改不掉)。FILE 优先;FILE 读不到或为空时服务拒绝启动
GRAMMAR_PROMPT=
GRAMMAR_PROMPT_FILE=

# ---- TTS(openai/* 走这里;azure/speech 走下面的 Azure)----
# 必须是真正提供 /audio/speech 的服务
UPSTREAM_TTS_BASE_URL=https://api.openai.com/v1
UPSTREAM_TTS_KEY=
# 可追加 volcengine/seed-tts-2.0(豆包语音;仅支持 2.0),如:openai/tts-1,azure/speech,volcengine/seed-tts-2.0
TTS_MODELS=openai/tts-1,azure/speech

# ---- 豆包语音合成(volcengine/* TTS)----
# 「豆包语音」控制台的 API Key(UUID 格式),不是火山方舟的 Key
VOLCENGINE_TTS_KEY=
VOLCENGINE_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional

# ---- Whisper(服务端转写)----
# 必须是真正提供 /audio/transcriptions(verbose_json 带时间戳)的服务
UPSTREAM_WHISPER_BASE_URL=https://api.openai.com/v1
UPSTREAM_WHISPER_KEY=
# openai(默认):multipart 透传到 /audio/transcriptions。
# chat:改用支持音频输入的对话模型转写(如火山方舟),需同时设置 UPSTREAM_WHISPER_MODEL。
UPSTREAM_WHISPER_MODE=openai
UPSTREAM_WHISPER_MODEL=

# ---- 火山大模型流式语音识别(可选,优先于上面的转写路径)----
# chat(默认):按 UPSTREAM_WHISPER_MODE 转写,行为不变。
# volc_stream:16 kHz 单声道 16 位 WAV 先走火山流式识别(UPSTREAM_WHISPER_MODE=openai 时
# 仅限 response_format 为空或 json 的请求);其他格式、并发已满、熔断中或任何失败都回退到
# UPSTREAM_WHISPER_MODE 的路径。未配置回退时:不适合流式的请求返回 503
# "Whisper upstream is not configured",流式失败返回 502(缺少密钥为 503)。
UPSTREAM_ASR_MODE=chat
ASR_STREAM_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
ASR_STREAM_RESOURCE_ID=volc.bigasr.sauc.duration
# 基础超时;实际为 min(该值 + 音频秒数, 120)
ASR_STREAM_TIMEOUT_SECONDS=30
# 每个进程同时进行的流式识别上限,超出直接走回退
ASR_STREAM_MAX_CONCURRENCY=3
# 留空则复用 VOLCENGINE_TTS_KEY(同一个 UUID Key)
VOLCENGINE_ASR_KEY=

# ---- Azure Speech(发音评测、默认 STT、azure/speech TTS)----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ---- 讯飞语音评测 ISE(发音评测;在讯飞开放平台控制台获取,密钥只放 .env)----
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_WS_URL=wss://ise-api.xfyun.cn/v2/open-ise

# ---- 网页版数据(对话、评测记录与录音)----
# 录音目录;留空时:SQLite 文件库 → 与库文件同目录;否则 /data(compose 卷)
DATA_DIR=
# 每个用户的录音总量上限(MB)、对话数上限、单个对话的消息数上限
RECORDING_QUOTA_MB=500
# 对话录音若超过该小时数仍未关联任何消息(如标签页中途关闭),下次保存对话录音时自动清理
CHAT_ORPHAN_GRACE_HOURS=6
MAX_CONVERSATIONS=200
MAX_MESSAGES_PER_CONVERSATION=1000
# 每个用户的练习清单(收藏的句子)条数上限
MAX_PRACTICE_ITEMS=500
# 每个用户的词汇本条数上限(超限 429)
MAX_VOCAB_ITEMS=2000
# ---- 语音提速与实时通话(计划 2026-10-07)----
# chat 模式识别:限制输出长度;"深度思考"开关 auto(默认,仅当识别上游主机是 volces.com 才发送 thinking)/ true(总是发送)/ false(从不发送)
STT_MAX_TOKENS=512
STT_DISABLE_THINKING=auto
# 火山大模型流式识别的开关与配置已在上方(UPSTREAM_ASR_MODE 等,spike 提交)
# 通话识别:buffered(整句缓冲后识别)或 stream(bigmodel_async 流式)
REALTIME_ASR_MODE=buffered
ASR_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# 实时通话(默认关;需要火山 TTS、LLM 与识别都可用)
REALTIME_ENABLED=false
REALTIME_MAX_MINUTES=10
REALTIME_IDLE_TIMEOUT_SECONDS=60
REALTIME_MAX_SESSIONS=5
REALTIME_TICKET_TTL_SECONDS=60
REALTIME_TTS_MODEL=volcengine/seed-tts-2.0
REALTIME_TTS_SAMPLE_RATE=24000
# 通话的 LLM 请求是否加 thinking: {"type": "disabled"}(DeepSeek v4 默认先推理,拖慢首句并占用 max_tokens)。
# auto(默认)= 仅当 UPSTREAM_LLM_BASE_URL 的主机是 deepseek.com 或 volces.com(含子域)时发送;true = 总是发送;false = 从不发送。
# OpenAI、Azure 等会对未知参数返回 400,所以 auto 不会向它们发送
REALTIME_LLM_DISABLE_THINKING=auto
# ---- 管理端(只读,计划 2026-10-08)----
# 访问 /admin,可查看所有用户的对话、评测与录音。ADMIN_USERNAME / ADMIN_PASSWORD 任一为空则整个管理端关闭(默认)。
# 密码至少 12 位;务必只经 HTTPS 暴露,建议在反向代理再限制来源 IP。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 管理端登录有效期(分钟)
ADMIN_TOKEN_TTL_MINUTES=480
# 管理端 token 的 HMAC 密钥;留空则每次启动随机生成(重启后需重新登录)
ADMIN_SESSION_SECRET=
# 管理端构建产物目录;留空使用 <仓库根>/admin/dist(Docker 镜像内为 /admin/dist)
ADMIN_DIST_DIR=
# 网页版构建产物目录;留空使用 <仓库根>/web/dist(Docker 镜像内为 /web/dist)
WEB_DIST_DIR=

# 客户端检查更新时看到的版本号
APP_VERSION=0.7.9

# ---- 段位赛与联机练习(docs/superpowers/specs/2026-10-09-rank-and-rooms-design.md)----
RANK_ENABLED=false
RANK_DAILY_RP_CAP=60
RANK_MATCH_DAILY_ATTEMPTS=3
RANK_MATCH_COOLDOWN_MINUTES=30
RANK_MATCH_MINUTES=20
RANK_MATCHES_GLOBAL_DAILY=200
# 留空 = DEFAULT_LLM_MODEL
RANK_JUDGE_MODEL=
RANK_SEASON_ANCHOR=2026-11-02
RANK_SEASON_WEEKS=8
ROOMS_ENABLED=false
ROOMS_AI_MODEL=
ROOMS_MAX_ACTIVE=50
ROOMS_MAX_MEMBERS=8
ROOMS_MAX_OWNED=3
ROOMS_IDLE_MINUTES=30
ROOMS_MAX_HOURS=24
# 房间关闭后消息/成员/举报的保留天数;0 = 永久保留(默认),正数 = 关闭满 N 天后由清扫删除
ROOM_MESSAGE_RETENTION_DAYS=0
ROOMS_TICKET_TTL_SECONDS=60
ROOMS_ASSIST_DAILY_PER_USER=60
ROOMS_AI_PER_ROOM_HOUR=30
ROOMS_AI_GLOBAL_DAILY=1000
ROOMS_AI_CONCURRENCY=4
