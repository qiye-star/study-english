# ---- 数据库(二选一,改这一行即可切换)----
# SQLite(默认,数据在 compose 卷 /data 中)
DATABASE_URL=sqlite+aiosqlite:////data/app.db
# Postgres(同时用 `docker compose --profile postgres up -d`)
# DATABASE_URL=postgresql+asyncpg://enjoy:change-me@postgres:5432/enjoy
# 注意:postgres 容器不会读取本文件。POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# 需在仓库根目录的 .env(见 .env.example)或 shell 环境变量中设置,
# 且密码必须与上面 DATABASE_URL 中的一致(默认值 enjoy / change-me / enjoy)。

# ---- 注册 ----
# open: 任何人可注册 | invite: 需要邀请码 | closed: 关闭注册
# 默认 closed 以免公网部署时被陌生人消耗你的上游额度。创建第一批账号时,
# 临时改为 open(或 invite),注册完再改回 closed 并重启;启用管理后台后也可在「运行时设置」里热切换。
REGISTRATION_MODE=closed
# invite 模式的 env 单码(不限次数);可留空,改用管理后台「邀请码」页发的多次码(限次数/过期/可撤销)。
# 两者都没有时 invite 模式下没人能注册(配置诊断会提示 invite_without_codes)
INVITE_CODE=
# 部署在反向代理之后时设为 true,使用 X-Forwarded-For 做限流/锁定/白名单。取最右一项(紧挨着的那层代理追加的地址),
# 所以只能有一层代理写该头;推荐让代理覆盖它(nginx: proxy_set_header X-Forwarded-For $remote_addr)
TRUST_PROXY_HEADERS=false
RATE_LIMIT_PER_MINUTE=10
# 每个用户每分钟可调用 AI 接口(/api/ai/*、/api/speech/tokens)的次数
AI_RATE_LIMIT_PER_MINUTE=60

# ---- 账号与邮箱(账号 v2)----
# 登录有效天数:每次使用时滑动续期,长期不用的登录在这段时间后失效(1–365,可热改;只影响之后签发的登录)
ACCESS_TOKEN_TTL_DAYS=30
# 身份 HMAC 密钥(邮箱登录与唯一性的查找键)。只从环境变量读取,不进管理后台;留空 = 邮箱功能关闭。
# 生成:python -c "import secrets; print(secrets.token_urlsafe(48))"(至少 32 个字符)
# 丢失或更换 = 所有邮箱登录与唯一性失效(无法从数据库恢复);请单独备份,不要与 SETTINGS_ENCRYPTION_KEY 放在同一处。
IDENTITY_PEPPER=
# 注册是否必须验证邮箱(true:邮箱 + 验证码 + 昵称必填)。SMTP 故障时可临时设为 false 恢复旧注册方式(用户名 + 密码 + 邀请码)。可热改。
# 邮箱功能需要 IDENTITY_PEPPER 与 SETTINGS_ENCRYPTION_KEY 两者都已设置,且 EMAIL_BACKEND 不是 off,否则相关接口返回 503。
EMAIL_REGISTRATION_REQUIRED=true
# 发信方式:off 关闭邮箱功能 | console 只在日志里记「已发送」(不记地址与内容,开发用)| smtp 真实发信。可热改。
EMAIL_BACKEND=off
# SMTP 服务器(QQ 邮箱:smtp.qq.com,465 + ssl 或 587 + starttls)。改主机会把 SMTP_PASSWORD 发到新地址。
SMTP_HOST=
# 端口:ssl 常用 465,starttls 常用 587(1–65535)
SMTP_PORT=465
# 加密方式:ssl(隐式 TLS)| starttls
SMTP_SECURITY=ssl
# 发件邮箱账号
SMTP_USER=
# 授权码(QQ 邮箱不是登录密码):按密钥处理,不进日志、审计与导出,不要提交
SMTP_PASSWORD=
# 发件人地址;留空 = SMTP_USER
SMTP_FROM=
# 同一邮箱 24 小时内最多生成几个验证码(1–100)
EMAIL_CODES_PER_TARGET_DAILY=10
# 同一 IP 每小时最多请求几个验证码(1–1000;进程内计数,多进程部署时按进程分别计)
EMAIL_CODES_PER_IP_HOURLY=10
# 全站每天最多发几封邮件(1–100000)。必须小于邮件服务商的日限额(限额以服务商说明或实测为准);通知邮件也占额度
EMAIL_DAILY_GLOBAL=200
# 邮箱域名策略:blocklist(拒绝内置临时邮箱,并追加 EMAIL_DOMAIN_LIST)| allowlist(只允许名单内;名单为空 = 国内主流邮箱)| any(不限)
EMAIL_DOMAIN_MODE=blocklist
# 逗号分隔的域名,含其子域(例:qq.com,163.com)
EMAIL_DOMAIN_LIST=
# 强制已有用户绑定邮箱:true 时,截止时间之前只显示横幅,截止时间之后未绑定的用户只能访问绑定页;截止时间为空 = 立即强制
EMAIL_BINDING_REQUIRED=false
# 绑定截止时间:带时区的 ISO 8601,例 2026-10-28T00:00+08:00;留空 = 无截止时间
EMAIL_BINDING_DEADLINE=

# ---- LLM(OpenAI 兼容)----
# 只需支持 chat completions(含流式)与 JSON 模式;客户端不使用 tool calling。
# DeepSeek 示例:UPSTREAM_LLM_BASE_URL=https://api.deepseek.com,LLM_MODELS=deepseek-v4-pro,deepseek-v4-flash
# (V4 默认 thinking 模式,不支持强制 tool_choice,本客户端不用)。api.openai.com 只是模板默认值。
UPSTREAM_LLM_BASE_URL=https://api.openai.com/v1
UPSTREAM_LLM_KEY=
LLM_MODELS=gpt-4o-mini,gpt-4o
DEFAULT_LLM_MODEL=gpt-4o
# 聊天请求的 max_tokens / max_completion_tokens 上限(n 固定最多 4);请求未带时不添加
LLM_MAX_TOKENS=4096

# ---- 语法检查模型(对话里自动指出语法错误)----
# 留空则使用 DEFAULT_LLM_MODEL;不必出现在 LLM_MODELS 中(客户端看不到、也不能指定)
GRAMMAR_MODEL=
# 留空则复用上面的 LLM 上游;设置了 BASE_URL 时使用下面这个 KEY(不会借用 LLM 的 KEY)
UPSTREAM_GRAMMAR_BASE_URL=
UPSTREAM_GRAMMAR_KEY=
# 替换内置的"检查规则"(输出格式要求由服务端固定追加,改不掉)。FILE 优先;FILE 读不到或为空时服务拒绝启动
GRAMMAR_PROMPT=
GRAMMAR_PROMPT_FILE=

# ---- TTS(openai/* 走这里;azure/speech 走下面的 Azure)----
# 必须是真正提供 /audio/speech 的服务
UPSTREAM_TTS_BASE_URL=https://api.openai.com/v1
UPSTREAM_TTS_KEY=
# 可追加 volcengine/seed-tts-2.0(豆包语音;仅支持 2.0),如:openai/tts-1,azure/speech,volcengine/seed-tts-2.0
TTS_MODELS=openai/tts-1,azure/speech

# ---- 豆包语音合成(volcengine/* TTS)----
# 「豆包语音」控制台的 API Key(UUID 格式),不是火山方舟的 Key
VOLCENGINE_TTS_KEY=
VOLCENGINE_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional

# ---- Whisper(服务端转写)----
# 必须是真正提供 /audio/transcriptions(verbose_json 带时间戳)的服务
UPSTREAM_WHISPER_BASE_URL=https://api.openai.com/v1
UPSTREAM_WHISPER_KEY=
# openai(默认):multipart 透传到 /audio/transcriptions。
# chat:改用支持音频输入的对话模型转写(如火山方舟),需同时设置 UPSTREAM_WHISPER_MODEL。
UPSTREAM_WHISPER_MODE=openai
UPSTREAM_WHISPER_MODEL=

# ---- 火山大模型流式语音识别(可选,优先于上面的转写路径)----
# chat(默认):按 UPSTREAM_WHISPER_MODE 转写,行为不变。
# volc_stream:16 kHz 单声道 16 位 WAV 先走火山流式识别(UPSTREAM_WHISPER_MODE=openai 时
# 仅限 response_format 为空或 json 的请求);其他格式、并发已满、熔断中或任何失败都回退到
# UPSTREAM_WHISPER_MODE 的路径。未配置回退时:不适合流式的请求返回 503
# "Whisper upstream is not configured",流式失败返回 502(缺少密钥为 503)。
UPSTREAM_ASR_MODE=chat
ASR_STREAM_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
ASR_STREAM_RESOURCE_ID=volc.bigasr.sauc.duration
# 基础超时;实际为 min(该值 + 音频秒数, 120)
ASR_STREAM_TIMEOUT_SECONDS=30
# 每个进程同时进行的流式识别上限,超出直接走回退
ASR_STREAM_MAX_CONCURRENCY=3
# 留空则复用 VOLCENGINE_TTS_KEY(同一个 UUID Key)
VOLCENGINE_ASR_KEY=

# ---- Azure Speech(发音评测、默认 STT、azure/speech TTS)----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ---- 讯飞语音评测 ISE(发音评测;在讯飞开放平台控制台获取,密钥只放 .env)----
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_WS_URL=wss://ise-api.xfyun.cn/v2/open-ise

# ---- 网页版数据(对话、评测记录与录音)----
# 录音目录;留空时:SQLite 文件库 → 与库文件同目录;否则 /data(compose 卷)
DATA_DIR=
# 每个用户的录音总量上限(MB)、对话数上限、单个对话的消息数上限
RECORDING_QUOTA_MB=500
# 对话录音若超过该小时数仍未关联任何消息(如标签页中途关闭),下次保存对话录音时自动清理
CHAT_ORPHAN_GRACE_HOURS=6
MAX_CONVERSATIONS=200
MAX_MESSAGES_PER_CONVERSATION=1000
# 每个用户的练习清单(收藏的句子)条数上限
MAX_PRACTICE_ITEMS=500
# 每个用户的词汇本条数上限(超限 429)
MAX_VOCAB_ITEMS=2000
# ---- 语音提速与实时通话(计划 2026-10-07)----
# chat 模式识别:限制输出长度;"深度思考"开关 auto(默认,仅当识别上游主机是 volces.com 才发送 thinking)/ true(总是发送)/ false(从不发送)
STT_MAX_TOKENS=512
STT_DISABLE_THINKING=auto
# 火山大模型流式识别的开关与配置已在上方(UPSTREAM_ASR_MODE 等,spike 提交)
# 通话识别:buffered(整句缓冲后识别)或 stream(bigmodel_async 流式)
REALTIME_ASR_MODE=buffered
ASR_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# 实时通话(默认关;需要火山 TTS、LLM 与识别都可用)
REALTIME_ENABLED=false
REALTIME_MAX_MINUTES=10
REALTIME_IDLE_TIMEOUT_SECONDS=60
REALTIME_MAX_SESSIONS=5
REALTIME_TICKET_TTL_SECONDS=60
REALTIME_TTS_MODEL=volcengine/seed-tts-2.0
REALTIME_TTS_SAMPLE_RATE=24000
# 通话的 LLM 请求是否加 thinking: {"type": "disabled"}(DeepSeek v4 默认先推理,拖慢首句并占用 max_tokens)。
# auto(默认)= 仅当 UPSTREAM_LLM_BASE_URL 的主机是 deepseek.com 或 volces.com(含子域)时发送;true = 总是发送;false = 从不发送。
# OpenAI、Azure 等会对未知参数返回 400,所以 auto 不会向它们发送
REALTIME_LLM_DISABLE_THINKING=auto
# ---- 管理端(计划 2026-10-08;v2 起可写:设置、治理、段位规则等,见 server/README.md「管理后台 v2」)----
# 访问 /admin。ADMIN_USERNAME / ADMIN_PASSWORD 是 env「应急」超级管理员(库里的管理员账号在后台「管理员与会话」创建);
# 任一为空则整个管理端关闭(默认)。密码至少 12 位;务必只经 HTTPS 暴露,建议在反向代理再限制来源 IP。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 管理会话的绝对有效期(分钟,5–1440);空闲超时见 ADMIN_IDLE_MINUTES
ADMIN_TOKEN_TTL_MINUTES=480
# 会话/CSRF/备份下载链接的签名密钥;留空则首次使用时随机生成并存入数据库(app_secrets,重启与多进程共用,会话不失效)。
# 更换此值会让所有管理员会话失效、需重新登录。生成:openssl rand -hex 32
ADMIN_SESSION_SECRET=
# 管理端构建产物目录;留空使用 <仓库根>/admin/dist(Docker 镜像内为 /admin/dist)
ADMIN_DIST_DIR=
# 网页版构建产物目录;留空使用 <仓库根>/web/dist(Docker 镜像内为 /web/dist)
WEB_DIST_DIR=

# ---- 管理后台 v2(docs/superpowers/specs/2026-10-09-admin-console-v2-design.md)----
# 加密主密钥:后台保存的上游密钥用它加密。留空则密钥类设置在后台只读。务必单独备份,丢失后库内密钥覆盖作废。
# 生成:python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=
# true = 忽略数据库里的全部设置覆盖,只用本文件(覆盖值把服务弄坏时的应急开关)
ADMIN_SETTINGS_SAFE_MODE=false
# 管理端来源 IP 白名单(逗号分隔 CIDR),空 = 不限制;判定受 TRUST_PROXY_HEADERS 影响
ADMIN_IP_ALLOWLIST=
# true(默认)= Cookie 带 Secure 且名为 __Host-enjoy_admin,必须经 HTTPS 访问;仅本地 http 开发设 false
ADMIN_COOKIE_SECURE=true
# 应急管理员的 TOTP 密钥(base32),留空 = 不启用
ADMIN_TOTP_SECRET=
# true = 所有超级管理员(含应急账号)必须绑定 TOTP 才能操作;打开前当前账号须已绑定
ADMIN_REQUIRE_TOTP=false
# 管理会话空闲多少分钟后失效
ADMIN_IDLE_MINUTES=30
# 同一账号+IP 连续失败多少次后锁定多少分钟(逐次加倍,有上限)
ADMIN_LOCKOUT_THRESHOLD=5
ADMIN_LOCKOUT_MINUTES=15
# 二次验证(危险操作前重新输入密码/TOTP)的有效分钟数
ADMIN_STEP_UP_MINUTES=5
# 审计日志保留天数(「数据与备份」页可手动清理更早的记录;哈希链从保留的第一条重新校验)
ADMIN_AUDIT_RETENTION_DAYS=365
# 维护模式:off | read_only(拒绝写操作)| full(除管理端外 API 全部 503)
MAINTENANCE_MODE=off
MAINTENANCE_MESSAGE_ZH=
MAINTENANCE_MESSAGE_EN=
# 上游单价(仅用于估算费用,不是账单),JSON;示例见 server/README.md「用量与费用」
USAGE_PRICES_JSON={}
# 估算费用的币种(只用于显示)
USAGE_CURRENCY=CNY
# 逐次上游调用记录保留天数;更早的汇总进按日统计后删除
USAGE_RAW_RETENTION_DAYS=90
# SQLite 备份目录,留空 = DATA_DIR/backups;保留份数;每日自动备份的 UTC 小时(-1 = 关)
BACKUP_DIR=
BACKUP_KEEP=7
BACKUP_HOUR_UTC=-1
# 构建版本(CI 注入),显示在系统页
BUILD_SHA=
# 日志级别:DEBUG | INFO | WARNING | ERROR(后台可热切换;DEBUG 算危险操作)
LOG_LEVEL=INFO

# 客户端检查更新时看到的版本号
APP_VERSION=0.7.9

# ---- 段位赛与联机练习(docs/superpowers/specs/2026-10-09-rank-and-rooms-design.md;server/README.md「段位赛与联机练习」)----
# 两个开关默认关:关闭时网页与原来完全一样(底部 3 个标签、练习页/「我的」无段位卡),/api/rank/*、/api/rooms/* 除 /config 外返回 404
RANK_ENABLED=false
# 每个用户每天(按用户本地日期)最多获得的段位点
RANK_DAILY_RP_CAP=60
# 每人每天最多打几场晋级赛;失败或放弃后冷却多少分钟
RANK_MATCH_DAILY_ATTEMPTS=3
RANK_MATCH_COOLDOWN_MINUTES=30
# 一场晋级赛的时限(分钟),超时作废
RANK_MATCH_MINUTES=20
# 全站每天最多开多少场晋级赛(成本上限;每场上游调用估算见 README)
RANK_MATCHES_GLOBAL_DAILY=200
# 评委模型;留空 = DEFAULT_LLM_MODEL
RANK_JUDGE_MODEL=
# 赛季起点(某个周一)与每季周数
RANK_SEASON_ANCHOR=2026-11-02
RANK_SEASON_WEEKS=8
# 联机练习(房间号 + 群聊 + @ai + 私聊助手);需要反向代理放行 WS /api/rooms/ws
ROOMS_ENABLED=false
# 房间 @ai 与助手的模型;留空 = DEFAULT_LLM_MODEL
ROOMS_AI_MODEL=
# 全站同时开着的房间上限、每房人数上限、每人同时拥有的房间上限
ROOMS_MAX_ACTIVE=50
ROOMS_MAX_MEMBERS=8
ROOMS_MAX_OWNED=3
# 无人发言多少分钟自动结束;房间最长存在多少小时
ROOMS_IDLE_MINUTES=30
ROOMS_MAX_HOURS=24
# 房间关闭后消息/成员/举报的保留天数;0 = 永久保留(默认),正数 = 关闭满 N 天后由清扫删除
ROOM_MESSAGE_RETENTION_DAYS=0
# 房间 WebSocket 票据有效期(秒,一次性;与实时通话一样不得进日志)
ROOMS_TICKET_TTL_SECONDS=60
# 私聊助手每人每天次数;每房每小时 @ai 次数;全站每天房间 AI 总次数(0 = 关闭房间 AI);并发上游调用数
ROOMS_ASSIST_DAILY_PER_USER=60
ROOMS_AI_PER_ROOM_HOUR=30
ROOMS_AI_GLOBAL_DAILY=1000
ROOMS_AI_CONCURRENCY=4

# ---- 联机练习 v2(docs/superpowers/specs/2026-10-10-rooms-v2-design.md §11.2;server/README.md「联机练习 v2」)----
# 创建表单 7 项设置、审批加入、邀请链接、停靠助手、引用/回应/正在输入随 ROOMS_ENABLED 生效,零上游成本。
# 以下全部登记在设置注册表,可在管理端热改(ROOMS_VOICE_CONCURRENCY 除外,需重启)。
# 语音消息子开关(有上游成本,默认关)。需要识别上游:火山流式识别,或 Whisper/对话模型兜底(见上方 UPSTREAM_*)。
# 关闭时不能上传/重试;已有语音照常播放与翻译。
ROOMS_VOICE_ENABLED=false
# 单条语音最长秒数(10–60;服务端多放 0.5 秒余量)
ROOMS_VOICE_MAX_SECONDS=60
# 每人每天最多发几条语音(0–1000,可在管理端按用户覆盖)
ROOMS_VOICE_DAILY_PER_USER=100
# 全站每天语音转写次数上限(含重试;0–100000)
ROOMS_VOICE_GLOBAL_DAILY=3000
# 每人每天(UTC 日)可上传的语音字节上限,MB(0–100000,可按用户覆盖)。
# 产品负责人确认:按天计算(200 MB/天 + 每天 100 条),不是累计总量;不占 RECORDING_QUOTA_MB。
ROOMS_VOICE_QUOTA_MB=200
# 同时进行的语音转写/翻译上游调用数(1–32;只在启动时读取,改了要重启)
ROOMS_VOICE_CONCURRENCY=4
# 语音存储格式:mp3(16 kHz 单声道 24 kbps,需要 lameenc)或 wav(兜底,约 10 倍体积)。
# 文件在 DATA_DIR/room_audio/,永久保存,须纳入部署方的目录备份。
ROOMS_VOICE_STORE_FORMAT=mp3
# 全站每天语音翻译次数上限(一条语音只翻译一次,全房共享;0–100000)
ROOMS_TRANSLATE_GLOBAL_DAILY=3000
# 房间结束时的 AI 学习小结子开关(有上游成本,默认关;需要 UPSTREAM_LLM_BASE_URL)
ROOMS_SUMMARY_ENABLED=false
# 全站每天最多生成几份小结(0–10000)
ROOMS_SUMMARY_GLOBAL_DAILY=200

# ---- 背单词(设计文档 2026-10-10-wordbook §10;说明见 server/README.md「背单词」)----
# 除 WORDBOOK_DATA_DIR 外都在设置注册表里,可在管理端「设置 → 背单词」热改(写审计)。数据是提交进仓库的
# KyleBing 词典文件(server/dictionaries/,只读),不导入数据库;学习记录在 vocabulary_items(source=wordbook:<书>)。
#
# 总开关(默认 false):关闭时 GET /api/wordbook/config 返回 {"enabled": false},其余 /api/wordbook/* 404,
# 练习页大卡与「我的」一行不显示;已有学习记录保留,重新打开即可继续。
# WORDBOOK_ENABLED=false
# AI「为什么」讲解子开关(默认 false;有上游 LLM 成本,还需要 UPSTREAM_LLM_BASE_URL)。关闭或上游不可用(含 402)时
# 讲解接口返回 503,网页显示「AI 讲解暂不可用」,词典自带的讲解照常显示。
# WORDBOOK_AI_ENABLED=false
# 启用的词书,逗号分隔,取 junior(初中)、senior(高中)、cet4、cet6、kaoyan(考研)、toefl、sat 的子集;
# 写未知的 id 启动报错。停用一本书只是不再出现在选书页,已学的词与进度不删。
# WORDBOOK_BOOKS=junior,senior,cet4,cet6,kaoyan,toefl,sat
# 新选书时的默认「每天新词」个数(5–100):首页「学新词」当天最多学这么多个新词;用户可在选书页改自己的值。
# WORDBOOK_DAILY_NEW=20
# 新选书时的默认「每天复习上限」(20–500):当天最多复习这么多个到期词,超出的顺延到明天;
# 到期积压超过上限时,当天新词最多 5 个(积压保护)。用户可改自己的值。
# WORDBOOK_REVIEW_CAP=100
# --- 背单词 v2:认识/模糊/不认识、快速回忆、每日目标(都在设置注册表里,管理端「设置 → 背单词」可热改)---
# 被用户点「认识」的新词里,抽多少百分比做一道选释义的小测来验证(0–100;0 = 不抽查,包括「点得太快必抽」也关掉)。
# 33 表示大约三分之一的「认识」会被抽查,答错会降档。抽中与否由服务端用私有种子决定,客户端猜不到。
# WORDBOOK_SPOT_CHECK_PCT=33
# 复习里是否出「快速回忆」题型(看词自评认识/模糊/不认识,再翻面确认)。关闭后不再出这种题,进行中的会提示题型不符。
# WORDBOOK_RECALL_ENABLED=true
# 新词卡出现、复习翻面时是否自动朗读单词(点「不认识」总是朗读;iOS 要等第一次点击之后才会自动出声)。
# WORDBOOK_AUTOPLAY=true
# 翻开释义后是否显示例句。
# WORDBOOK_SHOW_EXAMPLE=true
# 用户在设置面板里能填的每日新词个数范围,和默认值必须满足 最小 <= 默认 <= 最大(WORDBOOK_DAILY_NEW 是默认值)。
# 管理员收窄范围后,用户已经存的超出范围的值只在读取时被夹到范围内,不会改库。
# WORDBOOK_DAILY_NEW_MIN=1
# WORDBOOK_DAILY_NEW_MAX=200
# 每日复习上限的可填范围(10–1000);是否允许选「不限」(不限 = 当天所有到期的词都复习,后期复习量可能激增)。
# WORDBOOK_REVIEW_CAP_MIN=10
# WORDBOOK_REVIEW_CAP_MAX=1000
# WORDBOOK_REVIEW_UNLIMITED=true
# 每人每天「加练」(超出当天目标额外多学新词)最多多少个新词(0–200;0 = 关闭加练)。每次最多 20 个。
# WORDBOOK_BONUS_MAX=50
# AI 讲解用的模型(留空 = DEFAULT_LLM_MODEL)。
# WORDBOOK_AI_MODEL=
# 全站每天(UTC 日)最多调用上游生成多少条讲解(0–100000;0 = 实际关闭 AI 讲解)。讲解一词一条、全站共享缓存,
# 命中缓存不计次也不调用上游;上游失败退还额度。每次调用 max_tokens 400。
# WORDBOOK_AI_GLOBAL_DAILY=200
# 每个用户每天最多触发多少次「未命中缓存」的讲解(0–1000);可在管理端按用户覆盖(配额键 wordbook_ai_daily_per_user)。
# WORDBOOK_AI_DAILY_PER_USER=20
# 词典目录(只在启动时读取,不在管理端显示)。留空 = 仓库里的 server/dictionaries/kylebing-english-vocabulary,
# 容器内为 /app/dictionaries/kylebing-english-vocabulary;目录里必须有 <书 id>.jsonl 与 SOURCE.json。
# 校验:cd server && uv run python scripts/wordbook_data.py verify
# 固定上限(代码常量,不是环境变量):每人每天作答 3000 次、举报例句 20 次;一轮学新词 5 个,一批复习 20 个,
# 拼写一组 3–6 句(默认 5),一次最多 4 组。
# WORDBOOK_DATA_DIR=

# ---- 学习联动(spec 2026-10-11-learning-links)----
# 都在设置注册表里,可在管理端「设置 → 学习联动」热改(写审计)。总开关关(默认)= 与未安装联动完全相同:
# 不发布事件、/api/links/* 除 config 外 404、网页只剩核心按钮。打开总开关后下面六个联动默认全开,每个用户还能在
# 「我的 → 学习联动」里单独关闭。事件通道是进程内有界队列(尽力而为):进程重启会丢掉尚未处理的事件。
# 通道、计数、熔断与每用户开关缓存(30 秒)都是每进程一份:多 worker 时用户关掉某个联动,其他进程最多 30 秒后生效。
# 对话消息正文只在内存里交给处理器,不入库、不进日志;联动接口的 URL 里不带词。详见 server/README.md「学习联动」。
# LINKS_ENABLED=false
# LINK_WORD_ACTIONS_ENABLED=true
# LINK_DAILY_TASKS_ENABLED=true
# LINK_MISTAKES_ENABLED=true
# LINK_PRON_SHADOW_ENABLED=true
# LINK_CHAT_WORDS_ENABLED=true
# 联动段位点:打开后联动可以给段位加少量点(只吃每日上限的剩余额度,子上限见段位规则 sources_daily_cap)。
# LINK_RANK_SOURCES_ENABLED=true
# 事件队列上限(10–10000;满了丢弃并计数)、单个处理器超时毫秒(100–10000)、熔断连续失败次数(1–100)与冷却秒数(5–3600)。
# LINKS_QUEUE_MAX=1000
# LINKS_HANDLER_TIMEOUT_MS=2000
# LINKS_BREAKER_FAILURES=5
# LINKS_BREAKER_COOLDOWN_SECONDS=60
# 联动记录保留天数(7–365):对话用词记录超过即清理;易错词 / 发音弱词移出 30 天后清理。
# LINKS_RETENTION_DAYS=90
# 每人每天最多记录几个「对话里用到的今日词」(1–50)。
# LINK_CHAT_WORDS_DAILY_MAX=10
# 今日词的大模型用法检查(默认关;有上游 LLM 成本,失败或 402 时按确定性结果降级)与全站每日次数(0–10000)。
# LINK_CHAT_WORDS_LLM_ENABLED=false
# LINK_CHAT_WORDS_LLM_GLOBAL_DAILY=200
# ---- 智能体(spec 2026-10-12-agents)----
# 都在设置注册表里,可在管理端「设置 → 智能体」热改(写审计,下一个回合生效)。总开关关(默认)= /api/agents/* 除 config 外
# 返回 404,网页看不到入口,对话与联机的行为与今天完全相同。回合计数存在 daily_usage 表(按 UTC 日,重启不丢)。
# 用户文本、回复、人设、记忆只在内存或用户自己的行里;日志只有数字(timing event=agent_turn ...)。
# AGENTS_ENABLED=false
# 导师模式「带我学」、记忆、联机里的角色三个子开关(总开关开时才有意义)。
# AGENTS_TUTOR_ENABLED=true
# AGENTS_MEMORY_ENABLED=true
# AGENTS_ROOMS_ENABLED=true
# 工具方式:prefetch = 调模型前并行预取已学词 / 易错词 / 到期词 / 查词(默认,每回合只有一次模型调用);
# native = 允许模型请求函数调用,但必须先在管理端「智能体」页运行函数调用探测且通过,否则按 prefetch 运行
# (本版本 native 与 prefetch 行为相同,额外一轮工具调用尚未实现);off = 不用任何学习数据工具(记忆除外)。
# AGENTS_TOOLS_MODE=prefetch
# 智能体回合用的模型(留空 = DEFAULT_LLM_MODEL);记忆整理用的便宜模型(留空 = AGENTS_MODEL)。
# AGENTS_MODEL=
# AGENTS_MEMORY_MODEL=
# 全站每天(UTC 日)最多多少个回合(0–100000;0 = 实际关闭)。一个回合 = 一次流式模型调用;上游在吐出第一个字之前失败会退还。
# AGENTS_TURNS_GLOBAL_DAILY=3000
# 每个用户每天最多多少个回合(0–10000);可在管理端按用户覆盖(配额键 agents_turns_daily_per_user)。
# AGENTS_TURNS_DAILY_PER_USER=300
# 每个用户每天最多整理几次记忆(0–1000;每次一个便宜模型调用,在回合结束后后台进行);配额键 agents_memory_extract_daily_per_user。
# AGENTS_MEMORY_EXTRACT_DAILY_PER_USER=100
# 每个用户每天最多开始几次导师会话(0–200;一次会话 3–12 题);配额键 agents_tutor_daily_per_user。
# AGENTS_TUTOR_DAILY_PER_USER=20
# 每个用户最多自建几个角色(0–50;0 = 不允许自建,内置角色照常可用);配额键 agents_personas_max。
# AGENTS_PERSONAS_MAX=10
# 人设原文最长字数(100–4000);只约束新建和修改,已存的长人设照常使用。人设总是排在我们的安全前言之后。
# AGENTS_PROMPT_MAX_CHARS=800
# 每个用户最多保留多少条长期记忆(10–2000),超出按「未置顶 × 低重要度 × 久未使用」淘汰。
# AGENTS_MEMORY_ITEMS_MAX=200
# 放进提示词的记忆块预算(0–2000,按 token 估算;0 = 不放记忆)。
# AGENTS_MEMORY_TOKENS=600
# 单个上下文来源(查词、已学词等)的超时毫秒数(20–250)。所有来源并行,总预算固定 250 毫秒;超时的来源记为「跳过」,不阻断回复。
# AGENTS_SOURCE_TIMEOUT_MS=150
# 每个回合带入最近多少条历史消息(2–50);客户端多发的由服务端夹掉,每条最多 2000 字。
# AGENTS_HISTORY_MAX=20
# 带入的历史消息总字数上限(500–100000,默认 8000):从最新一条往前取,整条放得下才带入,不会截断单条;防止客户端用大量长历史放大输入 token。
# AGENTS_HISTORY_CHARS_MAX=8000
# 回复的 max_tokens:聊天模式(64–2000,默认 300,约 200 个英文单词)、导师模式(64–2000,默认 350)。同时受 LLM_MAX_TOKENS 约束。
# AGENTS_CHAT_MAX_TOKENS=300
# AGENTS_TUTOR_MAX_TOKENS=350
# 固定上限(代码常量,不是环境变量):本轮输入最多 2000 字;请求里 history 最多 50 条;每人同时进行的回合最多 2 个;
# 同一 client_turn_id 10 分钟内重发返回同一结果;每人每天举报角色最多 20 次;回合过程(agent_trace)最多 4 KB;
# 所有上下文来源的总预算 250 毫秒。

# ---- 跟读库(spec 2026-10-13-video-import §5.2;说明见 server/README.md「跟读库」)----
# 总开关(默认关)。关 = /api/library/* 除 config 外 404,网页不显示入口;打开还需要服务器装有 ffmpeg / ffprobe
# (镜像已装)。除最后两项外都在设置注册表里,可在管理端「设置 → 跟读库」热改(写审计)。
# LIBRARY_ENABLED=false
# 没有字幕时用现有语音识别上游转写(会花钱;需要 UPSTREAM_ASR_MODE=volc_stream 或已配置的 Whisper / chat 转写)。
# LIBRARY_ASR_ENABLED=false
# 每人媒体总量上限(MB,1–1000000);管理端可按用户覆盖(配额键 library_quota_mb)。数据卷要留够空间。
# LIBRARY_QUOTA_MB=2000
# 每人条目数上限(1–10000);可按用户覆盖(配额键 library_max_items)。
# LIBRARY_MAX_ITEMS=100
# 单个上传文件上限(MB,1–20000)。上传是 8 MiB 一片的分片,反向代理的 client_max_body_size 设 9m 以上即可。
# LIBRARY_MAX_UPLOAD_MB=500
# 单条时长上限(分钟,1–600);上传与链接都按探测出的时长检查,也给转码时间封顶。
# LIBRARY_MAX_DURATION_MINUTES=90
# 识别分钟数:每人每天(0–2000)与全站每天(0–100000)。开始转写前按秒预留,失败时退还没转写的部分。
# LIBRARY_ASR_MINUTES_DAILY_PER_USER=60
# LIBRARY_ASR_MINUTES_GLOBAL_DAILY=600
# 每人每天新建条目(上传 + 链接)次数(0–1000;0 = 不能新建)。
# LIBRARY_IMPORTS_DAILY_PER_USER=20
# 同时处理的条目数(1–4);ffmpeg / yt-dlp 吃 CPU 与带宽,小机器保持 1。
# LIBRARY_JOB_CONCURRENCY=1
# 视频转码与链接取回的最大高度(像素,240–1080)。
# LIBRARY_TRANSCODE_MAX_HEIGHT=720
# --- 每句译文与 AI 分析(D8):调现有大模型上游生成,存进句子行,重复打开不再花钱 ---
# 总开关(默认关,会花钱)。关 = 译文 / 分析接口返回 404,网页不显示「译」与「分析」。需要已配置大模型上游(UPSTREAM_LLM_*)。
# LIBRARY_AI_ENABLED=false
# 每人每天生成译文的句数(0–20000;命中已存的译文不计),生成分析的次数(0–1000;命中已存的不计)。
# LIBRARY_TRANSLATE_DAILY_PER_USER=500
# LIBRARY_ANALYSIS_DAILY_PER_USER=30
# 全站每天上述两类合计的句数上限(0–1000000)。
# LIBRARY_AI_DAILY_GLOBAL=5000
# 精选库(内置素材):用户侧「精选」页签开关(默认关;管理端导入不受影响)
# LIBRARY_CATALOG_ENABLED=false
# 精选素材的句子 AI 分析:首次生成后所有用户共享,系统付费;每天全站最多生成多少句
# LIBRARY_CATALOG_AI_DAILY=300
# --- 链接导入(yt-dlp,计划 S2)。警告:打开后服务器会访问用户提交的网址并下载内容 ---
# 只支持 yt-dlp 能直接下载的公开页面;受 DRM 保护的流媒体(Netflix、Disney+、爱奇艺、腾讯视频、优酷、Spotify 等)无法导入。
# LIBRARY_LINK_IMPORT_ENABLED=false
# 单次链接取回的墙钟超时(分钟,1–120)。
# LIBRARY_LINK_TIMEOUT_MINUTES=20
# 允许 yt-dlp 的通用抓取器(generic)。警告:打开后服务器可能请求任意网页(SSRF 面变大),默认关。
# LIBRARY_LINK_ALLOW_GENERIC=false
# cookies 文件(Netscape 格式,只读挂载)。含账号会话,等同密钥;务必用专门的小号,主账号有被平台限制的风险。只能写在 .env 里。
# LIBRARY_YTDLP_COOKIES_FILE=
# 链接取回时走的代理(可能含账号口令,等同密钥);只能写在 .env 里。机房 IP 常被拦,最稳的办法是在本机下载后上传文件。
# LIBRARY_YTDLP_PROXY=
